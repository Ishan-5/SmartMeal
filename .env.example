# SmartMeal environment
# Copy to .env.local for local development. Never commit .env.local or real keys.
# All values are optional: without keys the app runs in demo mode with a local JSON store.

# --- Public app URL ---
# Set this to the final https://...vercel.app URL before deploying so canonical URLs,
# the sitemap and social previews point at the right domain.
APP_URL=http://localhost:3000

# --- Free AI: photo recognition ---
# OpenRouter free tier handles vision. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=particle-ai/particle-1:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Free AI: weekly planning ---
# Groq free tier handles fast text generation. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional provider overrides: groq, openrouter, gemini, openai, demo
# AI_SCAN_PROVIDER=openrouter
# AI_PLAN_PROVIDER=groq
# AI_PROVIDER=demo

# Optional timeouts in milliseconds. Short values keep serverless requests responsive.
# AI_TIMEOUT_MS=12000
# AI_SCAN_TIMEOUT_MS=18000

# Optional Gemini fallback. Some Google projects have no free tier enabled.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional paid fallback. Not needed for the free product.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Free database: Supabase ---
# Required on Vercel. Run supabase/schema.sql first, then use the service_role key (NOT anon).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for `npm run db:migrate` (Node 20.6+ for --env-file).
# DATABASE_URL=postgresql://postgres:password@host:6543/postgres

# Local JSON store fallback (ignored when Supabase is configured).
DATA_DIR=./data

# Protects GET /api/admin/waitlist. Use a long random value.
ADMIN_TOKEN=

# Optional structured log level: debug, info, warn or error.
# LOG_LEVEL=info

# Internal only: allows a production build to run alongside `npm run dev`.
# NEXT_DIST_DIR=.next-build
