# SmartMeal environment
# All of these are optional. Demo mode runs with no keys at all.

# --- Free AI ---
# OpenRouter free tier handles PHOTO RECOGNITION (vision). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=particle-ai/particle-1:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
APP_URL=http://localhost:3000

# Groq free tier handles WEEKLY PLANNING (text). Get a key at https://console.groq.com/keys
# Much faster than the vision model; falls back to OpenRouter if unavailable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional overrides (provider names: groq, openrouter, gemini, openai)
# AI_SCAN_PROVIDER=openrouter
# AI_PLAN_PROVIDER=groq

# Alternative: Google Gemini. NOTE: some Google projects do not have the free tier enabled.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Paid fallback (only if you choose to use it)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Force demo mode
# AI_PROVIDER=demo

# --- Free database (Supabase free tier) ---
# Project URL + service_role key (NOT the anon key). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local JSON store fallback (used when Supabase is not configured)
DATA_DIR=./data

# Optional: protects /api/admin/waitlist CSV export
ADMIN_TOKEN=
