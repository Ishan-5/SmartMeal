# SmartMeal environment
# All of these are optional. Demo mode runs with no keys at all.

# --- Free AI ---
# Recommended: OpenRouter free tier. Get a key at https://openrouter.ai/keys
# Free vision model used by default (no billing required):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
APP_URL=http://localhost:3000

# Alternative: Google Gemini. NOTE: some Google projects do not have the free tier enabled.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Paid fallback (only if you choose to use it)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Force demo mode
# AI_PROVIDER=demo

# --- Free database (Supabase free tier) ---
# Project URL + service_role key (NOT the anon key). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local JSON store fallback (used when Supabase is not configured)
DATA_DIR=./data

# Optional: protects /api/admin/waitlist CSV export
ADMIN_TOKEN=
